# Sao chép file này thành local.env rồi sửa. Dòng bắt đầu bằng # là ghi chú.
# Thư mục chứa video để chọn trong app (bước 1, mục "Video có sẵn trên máy xử lý"). Trên Windows dùng dấu / hoặc \
MEDIA_DIR=D:/Videos
# Video và SRT xuất xong được chép thêm vào đây (bỏ dòng này nếu không cần)
EXPORT_DIR=D:/Videos/exports
# Cổng chạy app (mặc định 8765)
#PORT=8765
# Tesseract/ffmpeg không nằm trong PATH thì chỉ đường dẫn ở đây
#TESSERACT_BIN=C:/Program Files/Tesseract-OCR/tesseract.exe
#FFMPEG_BIN=C:/ffmpeg/bin/ffmpeg.exe
